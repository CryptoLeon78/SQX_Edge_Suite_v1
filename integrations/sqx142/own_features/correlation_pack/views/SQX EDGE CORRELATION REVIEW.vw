<?xml version="1.0" encoding="UTF-8"?>
<View name="SQX EDGE CORRELATION REVIEW">
  <Columns>
    <Column class="Symbol" name="Symbol" width="80"/>
    <Column class="TimeFrame" name="TimeFrame" width="70"/>
    <Column class="MiniEquityChart" name="MiniEquityChart" width="150"/>
    <Column class="Fitness" name="Fitness" width="80"/>
    <Column class="ProfitFactor" name="ProfitFactor" width="90"/>
    <Column class="ReturnDDRatio" name="ReturnDDRatio" width="95"/>
    <Column class="DrawdownPct" name="DrawdownPct" width="90"/>
    <Column class="NumberOfTrades" name="NumberOfTrades" width="90"/>
    <Column class="SQXEdgeCorrDecision" name="SQXEdgeCorrDecision" width="120"/>
    <Column class="SQXEdgeCorrRank" name="SQXEdgeCorrRank" width="90"/>
    <Column class="SQXEdgeCorrScore" name="SQXEdgeCorrScore" width="100"/>
    <Column class="SQXEdgeMaxCorr" name="SQXEdgeMaxCorr" width="100"/>
    <Column class="SQXEdgeCorrStatus" name="SQXEdgeCorrStatus" width="120"/>
    <Column class="SQXEdgeNearestWinner" name="SQXEdgeNearestWinner" width="150"/>
    <Column class="EntryIndicators" name="EntryIndicators" width="140"/>
