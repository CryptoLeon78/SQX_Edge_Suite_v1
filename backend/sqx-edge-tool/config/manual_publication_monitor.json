{
  "version": 1,
  "state": "manual_publication_monitor_ready",
  "monitorId": "manual_publication_monitor",
  "offerId": "sqx_edge_pro_manual_publication_monitor",
  "name": "Manual Limited Publication Monitor",
  "dependsOn": {
    "manualLimitedPublicationRecordConfig": "backend/sqx-edge-tool/config/manual_limited_publication_record.json",
    "manualLimitedPublicationRecordState": "manual_limited_publication_record_ready"
  },
  "requiredFiles": [
    "docs/sales/MANUAL_PUBLICATION_MONITOR.md",
    "docs/sales/MANUAL_LIMITED_PUBLICATION_RECORD.md",
    "docs/sales/OPERATOR_PUBLICATION_REVIEW.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "allowedSourceDecisions": [
    "record_manual_publication"
  ],
  "allowedDecisions": [
    "continue_monitoring",
    "prepare_traffic_expansion_review",
    "hold_for_fix",
    "pause_sales"
  ],
  "minimumObservationHours": 24,
  "maximumIncidents": 0,
  "maximumSupportGaps": 0,
  "maximumRefundRequests": 0,
  "maximumClaimsFlags": 0,
  "minimumPositiveSignalsForExpansionReview": 1,
  "privacyPolicy": "store_only_redacted_monitoring_counts_decision_owner_and_next_action_without_buyer_identity_checkout_payloads_or_license_files",
  "monitorPolicy": "monitor_manual_limited_publication_before_any_traffic_expansion_and_block_scaling_when_support_claims_refunds_or_incidents_are_unresolved",
  "decisionRules": [
    "prepare_traffic_expansion_review requires enough observation time, at least one positive signal, no incidents, no support gaps, no refund requests and no claims flags.",
    "incidents, support gaps, refund requests or claims flags require hold_for_fix or pause_sales.",
    "continue_monitoring is valid when observation is not mature enough for expansion review.",
    "this gate records monitoring evidence only; it never expands traffic automatically."
  ]
}
