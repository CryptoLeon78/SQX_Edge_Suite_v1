{
  "version": 1,
  "state": "controlled_commercial_next_movement_ready",
  "decisionId": "controlled_commercial_next_movement",
  "offerId": "sqx_edge_pro_controlled_commercial_next_movement",
  "name": "Controlled Commercial Next Movement",
  "dependsOn": {
    "controlledTrafficExpansionExecutionMonitorConfig": "backend/sqx-edge-tool/config/controlled_traffic_expansion_execution_monitor.json",
    "controlledTrafficExpansionExecutionMonitorState": "controlled_traffic_expansion_execution_monitor_ready"
  },
  "requiredFiles": [
    "docs/sales/CONTROLLED_COMMERCIAL_NEXT_MOVEMENT.md",
    "docs/sales/CONTROLLED_TRAFFIC_EXPANSION_EXECUTION_MONITOR.md",
    "docs/sales/CONTROLLED_TRAFFIC_EXPANSION_EXECUTION.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "allowedSourceMonitorDecisions": [
    "continue_observation",
    "prepare_new_decision",
    "hold_for_fix",
    "pause_sales"
  ],
  "allowedNextMovements": [
    "continue_observation",
    "prepare_next_micro_step",
    "prepare_private_review_packet",
    "hold_for_fix",
    "pause_sales"
  ],
  "minimumObservationHours": 24,
  "minimumPositiveSignalsForMovement": 1,
  "maximumOpenSupportItems": 0,
  "maximumRefundRequests": 0,
  "maximumClaimsIssues": 0,
  "maximumIncidents": 0,
  "privacyPolicy": "store_only_redacted_next_movement_decision_counts_owner_rationale_and_next_gate_without_buyer_identity_checkout_payloads_or_license_files",
  "decisionPolicy": "decide_next_controlled_commercial_movement_from_m86_evidence_without_automatic_traffic_checkout_email_or_license_actions",
  "decisionRules": [
    "prepare_next_micro_step requires M86 prepare_new_decision, at least one positive signal and no support, refund, claims or incident risk.",
    "prepare_private_review_packet requires M86 prepare_new_decision, completed monitor status and no risk.",
    "continue_observation is valid when no risk is present and the operator chooses not to move.",
    "hold_for_fix is valid when support/onboarding/copy needs work but sales do not need to pause.",
    "pause_sales is required when refunds, claims, incidents or paused monitor evidence are present."
  ]
}
