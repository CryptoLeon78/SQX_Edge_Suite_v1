{
  "version": 1,
  "state": "controlled_traffic_expansion_execution_monitor_ready",
  "monitorId": "controlled_traffic_expansion_execution_monitor",
  "offerId": "sqx_edge_pro_controlled_traffic_expansion_execution_monitor",
  "name": "Controlled Traffic Expansion Execution Monitor",
  "dependsOn": {
    "controlledTrafficExpansionExecutionConfig": "backend/sqx-edge-tool/config/controlled_traffic_expansion_execution.json",
    "controlledTrafficExpansionExecutionState": "controlled_traffic_expansion_execution_ready"
  },
  "requiredFiles": [
    "docs/sales/CONTROLLED_TRAFFIC_EXPANSION_EXECUTION_MONITOR.md",
    "docs/sales/CONTROLLED_TRAFFIC_EXPANSION_EXECUTION.md",
    "docs/sales/CONTROLLED_TRAFFIC_EXPANSION_DECISION.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "allowedSourceExecutionResults": [
    "repeat_step_recorded",
    "private_review_packet_prepared",
    "fix_hold_recorded",
    "sales_pause_recorded",
    "observation_continued"
  ],
  "allowedMonitorStatuses": [
    "completed",
    "partial",
    "blocked",
    "paused"
  ],
  "allowedDecisions": [
    "continue_observation",
    "prepare_new_decision",
    "hold_for_fix",
    "pause_sales"
  ],
  "minimumObservationHours": 24,
  "minimumPositiveSignalsForNewDecision": 1,
  "maximumOpenSupportItems": 0,
  "maximumRefundRequests": 0,
  "maximumClaimsIssues": 0,
  "maximumIncidents": 0,
  "privacyPolicy": "store_only_redacted_execution_monitor_counts_decision_owner_and_next_action_without_buyer_identity_checkout_payloads_or_license_files",
  "monitorPolicy": "monitor_m85_execution_result_before_any_further_traffic_or_commercial_movement",
  "decisionRules": [
    "prepare_new_decision requires completed or partial M85 execution evidence, at least one positive signal and no support, refund, claims or incident risk.",
    "continue_observation is valid when no risk is present and the operator chooses not to move again.",
    "hold_for_fix is valid when support/onboarding/copy needs work but sales do not need to pause.",
    "pause_sales is required when refunds, claims, incidents or paused execution evidence are present."
  ]
}
