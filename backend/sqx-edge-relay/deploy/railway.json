{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/sqx-edge-relay/Dockerfile"
  },
  "deploy": {
    "startCommand": "gunicorn api.server:app --bind 0.0.0.0:${PORT:-6060} --workers ${WEB_CONCURRENCY:-1} --threads ${WEB_THREADS:-4} --timeout ${WEB_TIMEOUT:-60}",
    "healthcheckPath": "/relay/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
