app = "sqx-edge-relay"
primary_region = "mad"

[build]
  dockerfile = "backend/sqx-edge-relay/Dockerfile"

[env]
  PORT = "6060"
  SQX_RELAY_WORKER_INTERVAL_SECONDS = "30"
  SQX_RELAY_WORKER_LIMIT = "10"

[[services]]
  internal_port = 6060
  protocol = "tcp"
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

  [[services.ports]]
    port = 80
    handlers = ["http"]

  [[services.ports]]
    port = 443
    handlers = ["tls", "http"]

  [[services.http_checks]]
    interval = "30s"
    timeout = "5s"
    method = "GET"
    path = "/relay/health"
