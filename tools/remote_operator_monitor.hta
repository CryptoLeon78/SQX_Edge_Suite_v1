<!doctype html>
<html>
<head>
  <meta http-equiv="x-ua-compatible" content="IE=edge">
  <title>SQX Edge Suite - Remote Status</title>
  <hta:application
    id="sqxRemoteMonitor"
    applicationname="SQX Edge Suite Remote Status"
    border="thin"
    caption="yes"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    singleinstance="no"
    sysmenu="yes"
    windowstate="normal"
  />
  <style>
    html, body {
      margin: 0;
      width: 680px;
      height: 668px;
      overflow: hidden;
      background: #08111f;
      color: #eef5ff;
      font-family: "Segoe UI", Arial, sans-serif;
    }
    .wrap { padding: 28px; }
    h1 { margin: 0 0 8px; font-size: 30px; line-height: 1.1; }
    .sub { margin: 0 0 24px; color: #b9c7d9; font-size: 13px; }
    .panel {
      padding: 16px;
      margin-bottom: 12px;
      border: 1px solid #263a5a;
      background: #132039;
      color: #dbe8ff;
      font-weight: 700;
      font-size: 14px;
      line-height: 1.35;
    }
    .ok {
      border-color: #1e7f55;
      background: #114d37;
      color: #9dffca;
    }
    .bad {
      border-color: #8b343c;
      background: #4c2228;
      color: #ffc0c0;
    }
    #overall {
      margin: 14px 0 18px;
      color: #ffda4d;
      font-weight: 700;
      font-size: 14px;
    }
    .actions { display: flex; gap: 12px; }
    button {
      width: 112px;
      height: 34px;
      background: #0e1728;
      border: 1px solid #335786;
      color: #fff;
      font-weight: 600;
      cursor: pointer;
    }
    button:disabled {
      opacity: .45;
      cursor: default;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>SQX Edge Suite</h1>
    <p class="sub">Control local Backend/Tunnel/Ollama para el portatil operador</p>
    <div id="backend" class="panel">Comprobando backend...</div>
    <div id="tunnel" class="panel">Comprobando tunel...</div>
    <div id="ollama" class="panel">Comprobando Ollama...</div>
    <div id="sqxcompat" class="panel">Comprobando SQX 142...</div>
    <div id="sqxperf" class="panel">Comprobando rendimiento SQX 142...</div>
    <div id="overall">Estado: iniciando comprobacion...</div>
    <div class="actions">
      <button id="startBtn" onclick="startServices()">Arrancar</button>
      <button id="stopBtn" onclick="stopServices()">Detener</button>
      <button id="refreshBtn" onclick="manualRefresh()">Refrescar</button>
      <button id="closeBtn" onclick="window.close()">Cerrar monitor</button>
    </div>
  </div>

  <script language="javascript">
    var shell = new ActiveXObject("WScript.Shell");
    var env = shell.Environment("PROCESS");
    var repo = env("SQX_REMOTE_ROOT");
    var cloudflared = env("SQX_CLOUDFLARED_PATH");
    var requestedMode = String(env("SQX_REMOTE_MODE") || "").toLowerCase();
    var busy = false;
    var lastAllOk = false;
    var launchMode = "";
    var statusFile = "";

    if (!repo) {
      repo = unescape(location.pathname).replace(/^\/?/, "").replace(/\/tools\/remote_operator_monitor\.hta$/i, "");
    }
    repo = repo.replace(/\//g, "\\").replace(/\\$/, "");
    statusFile = repo + "\\.local\\remote_service\\remote_operator_probe.latest.json";
    if (!cloudflared) {
      cloudflared = "C:\\Tools\\cloudflared\\cloudflared.exe";
    }

    function quote(value) {
      return '"' + String(value).replace(/"/g, '\\"') + '"';
    }

    function setPanel(id, ok, text) {
      var el = document.getElementById(id);
      el.className = "panel " + (ok ? "ok" : "bad");
      el.innerText = text;
    }

    function parseJson(value) {
      try { return JSON.parse(value || "{}"); } catch (e) { return null; }
    }

    function backendStatus() {
      try {
        var xhr = new ActiveXObject("MSXML2.XMLHTTP");
        xhr.open("GET", "http://127.0.0.1:5050/api/health", false);
        xhr.send();
        var ok = xhr.status === 200 && xhr.responseText.indexOf('"ok":true') >= 0;
        return {
          ok: ok,
          text: ok ? "OK - backend activo en 127.0.0.1:5050" : "NO-GO - backend responde sin OK"
        };
      } catch (e) {
        return { ok: false, text: "NO-GO - backend no responde" };
      }
    }

    function tunnelStatus() {
      try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if (!fso.FileExists(statusFile)) {
          return { ok: false, text: "Comprobando tunel..." };
        }
        var file = fso.OpenTextFile(statusFile, 1, false);
        var output = file.ReadAll();
        file.Close();
        if (output.indexOf('"ok":true') >= 0 && output.indexOf('"tunnel":{"ok":true') >= 0) {
          var pidMatch = output.match(/"processId":([0-9]+)/);
          return {
            ok: true,
            text: "OK - tunel Cloudflare activo" + (pidMatch ? " (PID " + pidMatch[1] + ")" : "")
          };
        }
        if (output.indexOf('"tunel no detectado"') >= 0) {
          return { ok: false, text: "NO-GO - tunel no detectado" };
        }
        return { ok: false, text: "NO-GO - tunel no comprobable" };
      } catch (e) {
        return { ok: false, text: "NO-GO - tunel no comprobable" };
      }
    }

    function ollamaStatus() {
      try {
        var xhr = new ActiveXObject("MSXML2.XMLHTTP");
        xhr.open("GET", "http://127.0.0.1:5050/api/agent/status", false);
        xhr.send();
        if (xhr.status !== 200) {
          return { ok: false, text: "NO-GO - Ollama/IA responde con error" };
        }
        var text = xhr.responseText || "";
        var ok = text.indexOf('"active":true') >= 0 || text.indexOf('"available":true') >= 0;
        var modelMatch = text.match(/"model":"([^"]+)"/);
        var reasonMatch = text.match(/"reason":"([^"]+)"/);
        var model = modelMatch ? modelMatch[1] : "modelo local";
        return {
          ok: ok,
          text: ok
            ? "OK - Ollama activo (" + model + ")"
            : "NO-GO - Ollama no disponible (" + model + (reasonMatch ? ", " + reasonMatch[1] : "") + ")"
        };
      } catch (e) {
        return { ok: false, text: "NO-GO - backend requerido para comprobar Ollama" };
      }
    }

    function sqxCompatStatus() {
      try {
        var xhr = new ActiveXObject("MSXML2.XMLHTTP");
        xhr.open("GET", "http://127.0.0.1:5050/api/sqx142/compat/status", false);
        xhr.send();
        if (xhr.status !== 200) {
          return { ok: false, status: "pending", text: "Pendiente - SQX 142 no comprobable" };
        }
        var text = xhr.responseText || "";
        var ok = text.indexOf('"ok":true') >= 0;
        var statusMatch = text.match(/"status":"([^"]+)"/);
        var procMatch = text.match(/"count":([0-9]+)/);
        var labelMatch = text.match(/"active":\{[^}]*"label":"([^"]+)"/);
        var status = statusMatch ? statusMatch[1] : "unknown";
        var procCount = procMatch ? procMatch[1] : "0";
        var label = labelMatch ? labelMatch[1] : "runtime desconocido";
        return {
          ok: ok,
          status: status,
          text: ok
            ? "OK - SQX 142 runtime alineado (" + label + ")"
            : "WARN - SQX 142 " + status + " - procesos: " + procCount
        };
      } catch (e) {
        return { ok: false, status: "pending", text: "Pendiente - backend requerido para comprobar SQX 142" };
      }
    }

    function sqxPerformanceStatus() {
      try {
        var xhr = new ActiveXObject("MSXML2.XMLHTTP");
        xhr.open("GET", "http://127.0.0.1:5050/api/sqx142/performance/status", false);
        xhr.send();
        if (xhr.status !== 200) {
          return { ok: false, status: "pending", profile: "unknown", text: "Pendiente - rendimiento SQX 142 no comprobable" };
        }
        var text = xhr.responseText || "";
        var payload = parseJson(text) || {};
        var ok = text.indexOf('"ok":true') >= 0;
        var statusMatch = text.match(/"status":"([^"]+)"/);
        var profileMatch = text.match(/"activeProfile":\{[^}]*"id":"([^"]+)"/);
        var diskMatch = text.match(/"freeHuman":"([^"]+)"/);
        var intelligence = payload.intelligence || {};
        var views = intelligence.views || {};
        var latest = intelligence.latestEvidence || payload.latestEvidence || {};
        var recommendation = intelligence.recommendation || {};
        var liveGuard = intelligence.liveGuard || {};
        var status = statusMatch ? statusMatch[1] : "unknown";
        var profile = payload.activeProfile && payload.activeProfile.id ? payload.activeProfile.id : (profileMatch ? profileMatch[1] : "unknown");
        var disk = payload.resources && payload.resources.disk && payload.resources.disk.freeHuman ? payload.resources.disk.freeHuman + " libre" : (diskMatch ? diskMatch[1] + " libre" : "disco desconocido");
        var viewsText = typeof views.presentCount !== "undefined" ? ("views " + views.presentCount + "/" + views.expectedCount) : "views ?";
        var evidence = latest.filename || "sin evidencia";
        var next = recommendation.label || "sin recomendacion";
        var guard = liveGuard.state ? ("guard " + liveGuard.state + "/alerts:" + (liveGuard.alertCount || 0)) : "guard ?";
        return {
          ok: ok,
          status: status,
          profile: profile,
          recommendation: next,
          text: ok
            ? "OK - Performance " + profile + " - " + disk + "\n" + viewsText + " - " + guard + " - evidencia: " + evidence + "\nNext: " + next
            : "WARN - Performance " + status + " - " + profile + " - " + disk + "\n" + viewsText + " - " + guard + " - evidencia: " + evidence + "\nNext: " + next
        };
      } catch (e) {
        return { ok: false, status: "pending", profile: "unknown", text: "Pendiente - backend requerido para comprobar rendimiento SQX 142" };
      }
    }

    function requestProbe() {
      var command = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File ' +
        quote(repo + "\\tools\\remote_operator_probe.ps1") +
        ' -RepoRoot ' + quote(repo) +
        ' -OutFile ' + quote(statusFile) +
        ' -Json';
      shell.Run(command, 0, false);
    }

    function setButtons(backendOk, tunnelOk, ollamaOk) {
      var anyRunning = backendOk || tunnelOk;
      var allOk = backendOk && tunnelOk && ollamaOk;
      document.getElementById("startBtn").disabled = busy || allOk;
      document.getElementById("stopBtn").disabled = busy || !anyRunning;
      document.getElementById("refreshBtn").disabled = busy;
      document.getElementById("closeBtn").disabled = busy;
      document.getElementById("startBtn").innerText = busy ? "Espere..." : (allOk ? "En marcha" : "Arrancar");
      document.getElementById("stopBtn").innerText = busy ? "Espere..." : (anyRunning ? "Detener" : "Detenido");
    }

    function refreshStatus(showOkPopup) {
      var backend = backendStatus();
      var tunnel = tunnelStatus();
      var ollama = backend.ok ? ollamaStatus() : { ok: false, text: "Pendiente - backend requerido para comprobar Ollama" };
      var sqxcompat = backend.ok ? sqxCompatStatus() : { ok: false, status: "pending", text: "Pendiente - backend requerido para comprobar SQX 142" };
      var sqxperf = backend.ok ? sqxPerformanceStatus() : { ok: false, status: "pending", profile: "unknown", text: "Pendiente - backend requerido para comprobar rendimiento SQX 142" };
      var allOk = backend.ok && tunnel.ok && ollama.ok;
      var anyRunning = backend.ok || tunnel.ok;
      setPanel("backend", backend.ok, backend.text);
      setPanel("tunnel", tunnel.ok, tunnel.text);
      setPanel("ollama", ollama.ok, ollama.text);
      setPanel("sqxcompat", sqxcompat.ok, sqxcompat.text);
      setPanel("sqxperf", sqxperf.ok, sqxperf.text);
      if (allOk) {
        document.getElementById("overall").style.color = "#9dffca";
        document.getElementById("overall").innerText = "Estado: OK servicios. SQX 142: " + sqxcompat.status + ". Perf: " + sqxperf.profile + "/" + sqxperf.status + " - " + (sqxperf.recommendation || "sin recomendacion") + ".";
      } else if (!anyRunning) {
        document.getElementById("overall").style.color = "#9dffca";
        document.getElementById("overall").innerText = "Estado: servicios detenidos. Backend/Tunnel cerrados.";
      } else {
        document.getElementById("overall").style.color = "#ffda4d";
        document.getElementById("overall").innerText = "Estado: parcial. Usa Arrancar/Detener o revisa logs locales.";
      }
      if (showOkPopup && allOk && !lastAllOk) {
        try { shell.Popup("Backend, Tunnel y Ollama estan OK.", 2, "SQX Edge Suite", 64); } catch (e) {}
      }
      lastAllOk = allOk;
      setButtons(backend.ok, tunnel.ok, ollama.ok);
      return { backendOk: backend.ok, tunnelOk: tunnel.ok, ollamaOk: ollama.ok, allOk: allOk, anyRunning: anyRunning };
    }

    function manualRefresh() {
      if (busy) return;
      requestProbe();
      window.setTimeout(function () { refreshStatus(false); }, 1200);
    }

    function finishStartCheck() {
      requestProbe();
      window.setTimeout(function () {
        busy = false;
        refreshStatus(true);
      }, 1600);
    }

    function runHidden(command) {
      shell.Run(command, 0, false);
    }

    function startServices() {
      if (busy) return;
      busy = true;
      setButtons(false, false, false);
      document.getElementById("overall").style.color = "#ffda4d";
      document.getElementById("overall").innerText = "Estado: arrancando backend, tunel y Ollama...";
      runHidden('powershell.exe -NoProfile -ExecutionPolicy Bypass -File ' +
        quote(repo + "\\tools\\remote_operator_start.ps1") +
        ' -RepoRoot ' + quote(repo) +
        ' -CloudflaredPath ' + quote(cloudflared));
      window.setTimeout(function () {
        document.getElementById("overall").innerText = "Estado: tunel arrancando. Verificando conexion Cloudflare...";
        requestProbe();
      }, 6500);
      window.setTimeout(finishStartCheck, 12500);
    }

    function stopServices() {
      if (busy) return;
      busy = true;
      setButtons(false, false, false);
      document.getElementById("overall").style.color = "#ffda4d";
      document.getElementById("overall").innerText = "Estado: deteniendo servicios...";
      runHidden('powershell.exe -NoProfile -ExecutionPolicy Bypass -File ' +
        quote(repo + "\\tools\\remote_operator_stop.ps1") +
        ' -RepoRoot ' + quote(repo));
      window.setTimeout(function () { busy = false; requestProbe(); window.setTimeout(function () { refreshStatus(false); }, 1200); }, 3000);
    }

    window.onload = function () {
      window.resizeTo(700, 698);
      var args = String(sqxRemoteMonitor.commandLine || "");
      launchMode = requestedMode || (args.indexOf("--stop") >= 0 ? "stop" : (args.indexOf("--start") >= 0 ? "start" : ""));
      requestProbe();
      var state = refreshStatus(launchMode !== "stop");
      if (launchMode === "start" && !state.allOk) startServices();
      if (launchMode === "stop" && state.anyRunning) stopServices();
    };
  </script>
</body>
</html>
